# =====================================================================
# Maia — Variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env real.
# =====================================================================

NODE_ENV=development
TZ=America/Sao_Paulo
APP_PORT=3000
LOG_LEVEL=info

# ---- Banco de dados ----
POSTGRES_USER=maia
POSTGRES_PASSWORD=trocar_senha_forte
POSTGRES_DB=maia
POSTGRES_PORT=5432
DATABASE_URL=postgres://maia:trocar_senha_forte@localhost:5432/maia

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- LLM Provider ----
# anthropic = direct Anthropic API (legacy default)
# openrouter = unified gateway (Claude / GPT / Llama / DeepSeek / Gemini ...)
LLM_PROVIDER=openrouter

# Required when LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_MAIN=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Required when LLM_PROVIDER=openrouter (recommended):
OPENROUTER_API_KEY=sk-or-...
# IMPORTANTE: o slug usa . (ponto) na versão, não - (dash). Ex: 4.6, não 4-6.
# IMPORTANTE: a Maia REQUER tool-calling. Lista filtrada:
#   https://openrouter.ai/models?supported_parameters=tools
OPENROUTER_MODEL_MAIN=anthropic/claude-sonnet-4.6
OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5
# Operator can change models at runtime via /dashboard/llm-settings (no restart).

# ---- OpenAI (Whisper) ----
OPENAI_API_KEY=sk-...
WHISPER_MODEL=whisper-1

# ---- Embeddings (voyage | openai | cohere) ----
# Defina o provider e a chave correspondente. EMBEDDING_MODEL deve combinar
# com o provider (prefixos: voyage-*, text-embedding-*, embed-*).
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=
COHERE_API_KEY=

# ---- WhatsApp / Baileys ----
BAILEYS_AUTH_DIR=./.baileys-auth
WHATSAPP_NUMBER_MAIA=+5511000000000
MAIA_DISPLAY_NAME=Maia

# ---- Governança ----
VALOR_LIMITE_SEM_CONFIRMACAO=1000.00
VALOR_LIMITE_DURO=10000.00
APROVAR_MENSAGENS_PROATIVAS=true

# ---- Owner (você) ----
OWNER_TELEFONE_WHATSAPP=+5511999999999
OWNER_NOME=Mendes

# ---- Observabilidade / Alertas ----
# Threshold diário (USD) para o cost monitor. Acima dispara alerta.
DAILY_LLM_USD_THRESHOLD=5
# Canais de alerta: log,email,telegram (separados por vírgula)
# ALERT_CHANNELS=log,email
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ALERT_EMAIL_TO=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---- Backup ----
# BACKUP_DIR=./backups
# BACKUP_RETENTION_LOCAL_DAYS=7
# BACKUP_S3_BUCKET=

# ---- Feature flags ----
# Multi-channel (P6): separates Agent / Channel / Role + Role Policy. Gates
# channel resolution (only seeded external_ids resolve, not arbitrary senders).
# Default false. SURVIVES the PR #406 teardown — removing it breaks prod.
# FEATURE_MULTI_CHANNEL=false

# Cognitive graph (P7): removed in #412 — the cognitive graph now runs
# unconditionally (parity with the imperative path proven), so there is no
# FEATURE_COGNITIVE_GRAPH toggle anymore.

# View-once for sensitive replies (saldos, comparativos). Default false.
# When true: outbound text replies for turns that ran a tool flagged
# `sensitive: true` (query_balance, compare_entities) are sent with the
# viewOnce flag, gated by pessoa.preferencias.balance_view_once.
# FEATURE_VIEW_ONCE_SENSITIVE=false

# PDF reports (extrato + comparativo) sent as WhatsApp documents. Default false.
# When true: the LLM can invoke `generate_report` to produce a PDF and send it
# with an LLM-written caption. View-once is NEVER applied to PDFs (spec B3b §11).
# FEATURE_PDF_REPORTS=false

# Outbound voice notes via OpenAI TTS. Default false.
# When true: voice-in conversations get voice-out replies (≤400 chars only).
# Text-in conversations always get text. PDF turns (B3b) always get PDF.
# Reuses OPENAI_API_KEY already configured for Whisper.
# FEATURE_OUTBOUND_VOICE=false

# Issue #292 — outbound_messages sweeper (#227/#233 follow-up).
# Worker `outbound_messages_sweeper` (cron */5 * * * *):
#   - STALE_PENDING_SEC: pending rows OLDER than this are promoted to 'unknown'
#     (terminal per #233's contract — boundary guard treats as sent_no_persist,
#     does NOT re-send). Default 300s (5min).
#   - RETENTION_DAYS: terminal rows (sent/failed/unknown) OLDER than this are
#     DELETED. Without retention the table grows ~1 row per inbound turn.
#     Default 30 days.
# OUTBOUND_SWEEPER_STALE_PENDING_SEC=300
# OUTBOUND_SWEEPER_RETENTION_DAYS=30

# =====================================================================
# Admin UI (Next.js, separate container — see src/admin-ui/Dockerfile)
# =====================================================================
# The admin-ui runs on port 4000 in its own container. In prod (Coolify),
# route `admin.${DOMAIN}` to this container and `${DOMAIN}` to the Fastify
# `app` container on :3000.
ADMIN_UI_PORT=4000

# NextAuth — required in production. Boot fails fast if NEXTAUTH_SECRET is
# missing or <32 chars.
NEXTAUTH_URL=http://localhost:4000
# Generate a fresh one BEFORE first boot:    openssl rand -base64 48
# The literal value below is a known placeholder — `resolveSecret()` rejects
# strings matching /^changeme-|change-?me|__PLACEHOLDER|__SET_ME__/i in
# production. Boot will FAIL fast if you copy this as-is.
NEXTAUTH_SECRET=__SET_ME__rotate_with_openssl_rand_base64_48_before_first_boot
# Required when behind a reverse proxy (Coolify, nginx, ALB). The proxy is
# the trusted edge for host validation. Without this, NextAuth v5 rejects
# requests whose Host header doesn't match NEXTAUTH_URL exactly.
AUTH_TRUST_HOST=true

# ---- Dev sign-in (magic-link via shared token) ----
# All three must be true/set for the dev provider to register. NEVER set
# any of these in production — the admin-ui's gating explicitly refuses
# to register the dev provider when NODE_ENV=production.
# FEATURE_ADMIN_UI_V1=true
# ALLOW_DEV_AUTH=true
# ADMIN_UI_DEV_LOGIN_TOKEN=at-least-16-random-chars

# ---- Production sign-in (OIDC / SSO) ----
# Set all four (or none) to register the OIDC provider. ISSUER MUST be https://
# in production — the boot will throw otherwise. OIDC_TENANT_SLUGS is a
# non-empty comma list of app_users.tenant_id values the IdP is allowed to
# authenticate into.
# OIDC_ISSUER=https://login.example.com/realms/maia
# OIDC_CLIENT_ID=maia-admin
# OIDC_CLIENT_SECRET=__SET_ME__copy_from_IdP_typically_32_to_64_random_chars
# OIDC_TENANT_SLUGS=default,acme
