# =====================================================================
# Maia — Variáveis de ambiente
#
# ARQUIVO GERADO — não edite à mão.
#   Fonte da verdade: src/config/contract.ts
#   Regenerar:        npm run config:generate
#   Verificar drift:  npm run config:check:drift
#
# Copie para .env e preencha. NUNCA comite o .env real.
# Valores marcados com __SET_ME__ / ... são PLACEHOLDERS: a validação
# estrita de staging e produção os recusa.
# =====================================================================

# ---- Core / processo ----
# Modo da plataforma Node (otimizações do runtime). NÃO é o profile da Maia
# — use MAIA_ENV.
# (default: development)
NODE_ENV=development

# Profile da Maia: development | staging | production. Decide quais regras
# de validação são obrigatórias. Quando ausente, é derivado de NODE_ENV.
# (obrigatória em: staging, production)
MAIA_ENV=development

# Timezone IANA usada em toda formatação/agendamento.
# (default: America/Sao_Paulo)
TZ=America/Sao_Paulo

# Porta HTTP do servidor Fastify.
# (default: 3000)
APP_PORT=3000

# Nível mínimo de log (pino).
# (default: info)
LOG_LEVEL=info

# Fail-closed do literal 'default' em tenant_id/agent_id (issue #323).
# Default ON; `false` é o rollback de emergência sem redeploy.
# (default: true · aplicável sem restart)
# MAIA_REJECT_DEFAULT_LITERAL=true

# ---- Banco de dados ----
# DSN completo do Postgres (inclui credenciais).
# (obrigatória em: development, staging, production · SEGREDO)
DATABASE_URL=postgres://maia:trocar_senha_forte@localhost:5432/maia

# Usuário do Postgres (usado pelo compose e pelo pg_dump).
# (obrigatória em: development, staging, production)
POSTGRES_USER=maia

# Senha do Postgres (mínimo 8 caracteres).
# (obrigatória em: development, staging, production · SEGREDO)
POSTGRES_PASSWORD=trocar_senha_forte

# Nome do banco.
# (obrigatória em: development, staging, production)
POSTGRES_DB=maia

# Porta do Postgres.
# (default: 5432)
POSTGRES_PORT=5432

# ---- Redis ----
# URL do Redis (filas BullMQ, dedup, debounce, rate limit).
# (obrigatória em: development, staging, production · SEGREDO)
REDIS_URL=redis://localhost:6379

# Porta do Redis (usada pelo compose).
# (default: 6379)
REDIS_PORT=6379

# ---- LLM provider ----
# Provider do LLM principal: anthropic (direto) ou openrouter (gateway).
# (default: anthropic)
LLM_PROVIDER=openrouter

# Chave da API Anthropic. Prefixo obrigatório `sk-ant-`.
# (obrigatória quando LLM_PROVIDER=anthropic · SEGREDO)
ANTHROPIC_API_KEY=sk-ant-...

# Chave da API OpenRouter. Prefixo obrigatório `sk-or-`.
# (obrigatória quando LLM_PROVIDER=openrouter · SEGREDO)
OPENROUTER_API_KEY=sk-or-...

# Slug do modelo principal no OpenRouter (a versão usa ponto: 4.6). Exige
# tool-calling.
# (default: anthropic/claude-sonnet-4.6 · aplicável sem restart)
OPENROUTER_MODEL_MAIN=anthropic/claude-sonnet-4.6

# Slug do modelo rápido no OpenRouter (classificação, judge).
# (default: anthropic/claude-haiku-4.5 · aplicável sem restart)
OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5

# Modelo principal na API Anthropic direta.
# (default: claude-sonnet-4-6 · aplicável sem restart)
CLAUDE_MODEL_MAIN=claude-sonnet-4-6

# Modelo rápido na API Anthropic direta.
# (default: claude-haiku-4-5-20251001 · aplicável sem restart)
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# Retries em chamada de LLM.
# (default: 3)
# CLAUDE_MAX_RETRIES=3

# Timeout (ms) de chamada de LLM.
# (default: 30000)
# CLAUDE_TIMEOUT_MS=30000

# Orçamento wall-clock total (ms) do Decision Engine. Abaixo de ~2000ms o
# hop Haiku estoura e cai no fallback ask_clarification.
# (default: 2500)
# DECISION_ENGINE_BUDGET_MS=2500

# ---- Transcrição de áudio (Whisper) ----
# Chave OpenAI (Whisper, TTS e embeddings openai). Prefixo `sk-`.
# (obrigatória quando EMBEDDING_PROVIDER=openai ou
# FEATURE_OUTBOUND_VOICE=true · SEGREDO)
OPENAI_API_KEY=sk-...

# Provider de transcrição de áudio.
# (default: openai)
# WHISPER_PROVIDER=openai

# Modelo de transcrição.
# (default: whisper-1)
WHISPER_MODEL=whisper-1

# ---- Embeddings ----
# Provider de embeddings: voyage | openai | cohere.
# (default: voyage)
EMBEDDING_PROVIDER=voyage

# Modelo de embeddings. O prefixo deve casar com o provider (voyage-*,
# text-embedding-*, embed-*).
# (default: voyage-3)
EMBEDDING_MODEL=voyage-3

# Dimensões do vetor. Precisa casar com o modelo E com a coluna pgvector já
# migrada.
# (default: 1024)
EMBEDDING_DIMENSIONS=1024

# Chave da Voyage AI.
# (obrigatória quando EMBEDDING_PROVIDER=voyage · SEGREDO)
VOYAGE_API_KEY=__SET_ME__voyage_api_key

# Chave da Cohere.
# (obrigatória quando EMBEDDING_PROVIDER=cohere · SEGREDO)
COHERE_API_KEY=__SET_ME__cohere_api_key

# ---- WhatsApp / Baileys ----
# Raiz do estado de sessão do Baileys. Precisa conter um segmento "baileys";
# raízes de sistema e o CWD são recusados (o recovery apaga diretórios sob
# esta raiz).
# (default: ./.baileys-auth)
BAILEYS_AUTH_DIR=./.baileys-auth

# Número E.164 da linha da Maia.
# (obrigatória em: development, staging, production)
WHATSAPP_NUMBER_MAIA=+5511000000000

# Nome exibido do agente.
# (default: Maia)
MAIA_DISPLAY_NAME=Maia

# ---- Owner ----
# Número E.164 do owner. Precisa ser diferente de WHATSAPP_NUMBER_MAIA.
# (obrigatória em: development, staging, production)
OWNER_TELEFONE_WHATSAPP=+5511999999999

# Nome do owner.
# (obrigatória em: development, staging, production)
OWNER_NOME=Mendes

# ---- Governança (limites financeiros e TTLs) ----
# Teto (BRL) para executar sem confirmação extra. Ordem obrigatória:
# SEM_CONFIRMACAO <= DUAL_APPROVAL <= LIMITE_DURO.
# (default: 1000)
VALOR_LIMITE_SEM_CONFIRMACAO=1000.00

# Acima deste valor (BRL) a operação exige aprovação dupla (4-eyes).
# (default: 20000)
VALOR_DUAL_APPROVAL=5000.00

# Teto absoluto (BRL). Acima disso a operação é negada.
# (default: 50000)
VALOR_LIMITE_DURO=10000.00

# Janela (h) para a segunda aprovação antes de expirar.
# (default: 6)
# DUAL_APPROVAL_TIMEOUT_HOURS=6

# TTL (h) do modo auditoria.
# (default: 24)
# AUDIT_MODE_TTL_HOURS=24

# Janela (min) do bucket de idempotência.
# (default: 5)
# IDEMPOTENCY_BUCKET_MINUTES=5

# TTL (min) de pergunta pendente.
# (default: 120)
# PENDING_QUESTION_TTL_MINUTES=120

# TTL (h) de ação pendente.
# (default: 6)
# PENDING_ACTION_TTL_HOURS=6

# Teto de mensagens processadas por hora por remetente.
# (default: 30)
# RATE_LIMIT_MSGS_PER_HOUR=30

# Minutos desconectado antes de alertar.
# (default: 5)
# WHATSAPP_RECONNECT_ALERT_MIN=5

# ---- Roteamento multi-linha ----
# Liga o LineSessionManager como dono do transporte por canal (fase 3).
# Default off = paridade mono-linha.
# (default: false)
# MAIA_MULTI_LINE=false

# shadow (só loga divergência) | exact_first (exact-match com fallback) |
# strict (exige staging operante, falha tipado no miss).
# (default: shadow)
# MAIA_CHANNEL_ROUTING_MODE=shadow

# Keyring JSON { key_id: base64(32B) } do staging cifrado de inbound
# não-roteado. Obrigatório no modo strict.
# (obrigatória quando MAIA_CHANNEL_ROUTING_MODE=strict · SEGREDO)
# MAIA_STAGING_KEYRING=__SET_ME__{"k1":"<base64 32 bytes>"}

# Id da chave ativa dentro de MAIA_STAGING_KEYRING.
# (obrigatória quando MAIA_CHANNEL_ROUTING_MODE=strict)
# MAIA_STAGING_ACTIVE_KEY_ID=k1

# ---- Observabilidade / alertas ----
# Canais de alerta separados por vírgula: log, email, telegram. Cada canal
# exige suas credenciais/destino.
# (default: email)
ALERT_CHANNELS=log

# Host SMTP do canal de e-mail.
# (obrigatória quando ALERT_CHANNELS contém email)
# SMTP_HOST=smtp.example.com

# Porta SMTP.
# SMTP_PORT=587

# Usuário SMTP.
# SMTP_USER=maia@example.com

# Senha SMTP.
# (SEGREDO)
# SMTP_PASS=__SET_ME__smtp_password

# Destinatário dos alertas por e-mail.
# (obrigatória quando ALERT_CHANNELS contém email)
# ALERT_EMAIL_TO=ops@example.com

# Token do bot do Telegram.
# (obrigatória quando ALERT_CHANNELS contém telegram · SEGREDO)
# TELEGRAM_BOT_TOKEN=__SET_ME__telegram_bot_token

# Chat de destino dos alertas no Telegram.
# (obrigatória quando ALERT_CHANNELS contém telegram)
# TELEGRAM_CHAT_ID=-1001234567890

# Tamanho da DLQ que dispara alerta.
# (default: 10)
# DLQ_ALERT_THRESHOLD=10

# ---- Backup / restore ----
# Diretório local dos dumps.
# (default: ./backups)
# BACKUP_DIR=./backups

# Retenção local (dias).
# (default: 7)
# BACKUP_RETENTION_LOCAL_DAYS=7

# Retenção remota (dias).
# (default: 30)
# BACKUP_RETENTION_CLOUD_DAYS=30

# Bucket de destino do backup remoto. Sem ele, o backup é só local.
# (obrigatória em: staging, production)
# BACKUP_S3_BUCKET=maia-backups

# Endpoint custom para provedores S3-compatíveis (Backblaze B2, Cloudflare
# R2, Wasabi). Vazio = AWS S3 nativo.
# BACKUP_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com

# Região do bucket.
# (default: us-east-1)
# BACKUP_S3_REGION=us-east-1

# Access key do bucket de backup.
# (obrigatória quando BACKUP_S3_BUCKET está definida · SEGREDO)
# BACKUP_S3_ACCESS_KEY=__SET_ME__s3_access_key

# Secret key do bucket de backup.
# (obrigatória quando BACKUP_S3_BUCKET está definida · SEGREDO)
# BACKUP_S3_SECRET_KEY=__SET_ME__s3_secret_key

# Prefixo dentro do bucket (sem barra inicial nem final).
# (default: maia)
# BACKUP_S3_PREFIX=maia

# ---- Custo ----
# Teto diário (USD) do cost monitor. Acima dispara alerta.
# (default: 5)
DAILY_LLM_USD_THRESHOLD=5

# ---- Feature flags ----
# MCP externo v1 (#478). Fail-closed: PROIBIDO em produção até o gate G4
# (threat model + pentest).
# (default: false · ativa apenas em: development, staging)
# FEATURE_MCP_TOOLS=false

# Mensagens proativas do agente.
# (default: false)
# FEATURE_PROACTIVE_MESSAGES=false

# Importação de extratos OFX.
# (default: false)
# FEATURE_OFX_IMPORT=false

# Dashboard operacional embutido no runtime.
# (default: false)
# FEATURE_DASHBOARD=false

# Gate de resolução de perguntas pendentes.
# (default: false)
# FEATURE_PENDING_GATE=false

# Sinais de presença (typing, read receipts).
# (default: false)
# FEATURE_PRESENCE=false

# Respostas one-tap (enquete/reação como resposta).
# (default: false)
# FEATURE_ONE_TAP=false

# Tratamento de edição/remoção de mensagem.
# (default: false)
# FEATURE_MESSAGE_UPDATE=false

# Lembretes de pendências.
# (default: false)
# FEATURE_PENDING_REMINDER=false

# Respostas sensíveis (saldos, comparativos) enviadas com viewOnce,
# gatilhado por preferência da pessoa.
# (default: false)
# FEATURE_VIEW_ONCE_SENSITIVE=false

# Relatórios PDF (extrato/comparativo) enviados como documento.
# (default: false)
# FEATURE_PDF_REPORTS=false

# Áudio de saída via OpenAI TTS (reutiliza OPENAI_API_KEY).
# (default: false)
# FEATURE_OUTBOUND_VOICE=false

# Ledger de idempotência de saída (#227) em outbound_messages.
# (default: false)
# FEATURE_OUTBOUND_DEDUP=false

# Agrupa textos picotados do mesmo remetente numa única rodada. Mídia sempre
# passa direto.
# (default: false)
# FEATURE_MESSAGE_DEBOUNCE=false

# Kill switch do runtime de procedimentos (selector + engine + avaliador).
# Default ON; a rodada ReAct base não depende dele.
# (default: true)
# FEATURE_PROCEDURE_RUNTIME=true

# ---- Sonda sintética ----
# Sonda sintética ponta-a-ponta. Inerte enquanto false. Exige
# MAIA_CHANNEL_ROUTING_MODE em exact_first ou strict.
# (default: false)
# MAIA_SYNTHETIC_PROBE=false

# Asserção secundária por LLM-as-judge na sonda (custo/ruído: off por
# default).
# (default: false)
# MAIA_PROBE_LLM_JUDGE=false

# Cadência do tick da sonda (1 cenário por tick).
# (default: */10 * * * *)
# MAIA_PROBE_CRON=*/10 * * * *

# Deadline (ms) do efeito colateral. Sem efeito no SLO ⇒ silent.
# (default: 30000)
# MAIA_PROBE_SLO_MS=30000

# Acima deste tempo (ms) mas dentro do SLO ⇒ slow.
# (default: 15000)
# MAIA_PROBE_SLO_WARN_MS=15000

# K falhas consecutivas para transicionar saudável→degradado e alertar.
# (default: 3)
# MAIA_PROBE_ALERT_AFTER_K=3

# N falhas consecutivas ativam o auto-silêncio (para de gastar LLM em loop).
# (default: 10)
# MAIA_PROBE_AUTOSILENCE_AFTER_N=10

# Intervalo (ms) de sondagem de recuperação durante o auto-silêncio.
# (default: 3600000)
# MAIA_PROBE_SILENCED_BACKOFF_MS=3600000

# TTL (ms) do cleanup de rows de run órfãs.
# (default: 300000)
# MAIA_PROBE_RUN_TTL_MS=300000

# Lease (ms) de single-flight da sonda.
# (default: 120000)
# MAIA_PROBE_LEASE_MS=120000

# log_only (default, staging-safe: log + métrica) ou alert (entrega por
# sendAlert com retry durável).
# (default: log_only)
# MAIA_PROBE_ALERT_MODE=log_only

# ---- Runtime trace ----
# Versão da chave HMAC em uso (rotação a cada 90d).
# (default: 1)
# RUNTIME_TRACE_HMAC_KEY_VERSION=1

# Segredo mestre do HMAC de auditoria. OBRIGATÓRIO em produção — sem ele os
# HMACs de auditoria seriam forjáveis.
# (obrigatória em: staging, production · SEGREDO)
# RUNTIME_TRACE_HMAC_MASTER_SECRET=__SET_ME__openssl_rand_base64_48

# Segredos anteriores, formato `versao=segredo` separados por `;`, retidos
# pela janela de retenção de auditoria.
# (SEGREDO)
# RUNTIME_TRACE_HMAC_PREV_MASTER_SECRETS=__SET_ME__1=<segredo-anterior>

# Bucket dos snapshots cifrados do modo debug (TTL 24h).
# RUNTIME_TRACE_DEBUG_S3_BUCKET=maia-trace-debug

# Chave AES-GCM (base64) dos snapshots de debug.
# (obrigatória quando RUNTIME_TRACE_DEBUG_S3_BUCKET está definida · SEGREDO)
# RUNTIME_TRACE_DEBUG_AES_KEY=__SET_ME__base64_32_bytes

# Idade máxima (s) de um envelope pendente antes do alerta do recoverer.
# (default: 300)
# RUNTIME_TRACE_BODY_ORPHAN_SEC=300

# Intervalo (s) de refresh da matview unified_trace_events.
# (default: 300)
# RUNTIME_TRACE_MATVIEW_REFRESH_SEC=300

# ---- Outbox / sweeper ----
# Rows 'pending' mais antigas que isso são promovidas a 'unknown'
# (terminal).
# (default: 300)
# OUTBOUND_SWEEPER_STALE_PENDING_SEC=300

# Retenção (dias) de rows terminais em outbound_messages.
# (default: 30)
# OUTBOUND_SWEEPER_RETENTION_DAYS=30

# Tamanho do chunk do DELETE de retenção (evita lock de tabela inteira).
# (default: 1000)
# OUTBOUND_SWEEPER_RETENTION_BATCH_SIZE=1000

# Teto de promoções stale-pending por tenant por passe (fairness).
# (default: 500)
# OUTBOUND_SWEEPER_RECOVERY_LIMIT_PER_TENANT=500

# Efeitos pendentes despachados por (tenant, agent) por passe.
# (default: 100)
# OUTBOX_RELAYER_BATCH_PER_TENANT=100

# Base (s) do backoff exponencial em falha transitória.
# (default: 30)
# OUTBOX_RELAYER_BASE_BACKOFF_SEC=30

# Teto (s) do backoff.
# (default: 3600)
# OUTBOX_RELAYER_MAX_BACKOFF_SEC=3600

# Retenção (dias) de rows terminais do outbox de efeitos.
# (default: 30)
# OUTBOX_RELAYER_RETENTION_DAYS=30

# Chunk do DELETE de retenção do relayer.
# (default: 1000)
# OUTBOX_RELAYER_RETENTION_BATCH_SIZE=1000

# Backpressure de saída: envios por segundo por instância de agente.
# (default: 2)
# OUTBOX_MAX_PER_SECOND=2

# Backpressure de saída: envios por hora por instância de agente.
# (default: 120)
# OUTBOX_MAX_PER_HOUR=120

# TTL (s) do lease de uma ocorrência antes de outro worker reclamar.
# (default: 300)
# OCCURRENCE_LEASE_TTL_SECONDS=300

# TTL (s) do lease do outbox.
# (default: 60)
# OUTBOX_LEASE_TTL_SECONDS=60

# Concorrência do worker de outbox.
# (default: 4)
# OUTBOX_WORKER_CONCURRENCY=4

# Passes de drain por tick.
# (default: 5)
# OUTBOX_DRAIN_LOOP_PASSES=5

# Sleep (ms) entre ticks de drain.
# (default: 200)
# OUTBOX_DRAIN_LOOP_SLEEP_MS=200

# Janela (ms) do debounce de mensagens; cada texto novo reinicia o timer.
# (default: 5000)
# MESSAGE_DEBOUNCE_MS=5000

# Teto absoluto (ms) do debounce.
# (default: 30000)
# MESSAGE_DEBOUNCE_MAX_MS=30000

# ---- Procedures / reaper ----
# Limiar (0,1] de confiança do selector de procedimentos. 0 auto-iniciaria
# em qualquer candidato.
# (default: 0.6)
# PROCEDURE_SELECTOR_CONFIDENCE_THRESHOLD=0.6

# Dias de inatividade após os quais o reaper marca a execução como
# 'abandoned'.
# (default: 7)
# PROCEDURE_TTL_DAYS=7

# Teto de leitura por tupla (tenant, agent) por tick do reaper.
# (default: 1000)
# REAPER_BATCH_SIZE=1000

# Orçamento GLOBAL de execuções ceifadas por tick, somando todas as tuplas.
# (default: 5000)
# REAPER_GLOBAL_BUDGET=5000

# Janela (h) em que uma contradição resolvida ainda aparece no prompt.
# (default: 24)
# CONTRADICTION_OVERLAY_TTL_HOURS=24

# ---- Performance / caches ----
# TTL (ms) do PolicyResolverCache.
# (default: 300000)
# POLICY_RESOLVER_CACHE_TTL_MS=300000

# Teto LRU do PolicyResolverCache.
# (default: 10000)
# POLICY_RESOLVER_CACHE_MAX_ENTRIES=10000

# Baseline (ms) do p95 do caminho síncrono. Ausente ⇒ o gate é pulado.
# SYNC_LATENCY_P95_BASELINE_MS=1200

# Percentual extra permitido sobre a baseline.
# (default: 20)
# SYNC_LATENCY_P95_BUDGET_PERCENT=20

# ---- Bootstrap / setup ----
# Override do token de bootstrap. Desencorajado em produção (env vaza mais
# que arquivo 0600), mas não proibido — deploys scriptados legítimos usam.
# (SEGREDO)
# SETUP_TOKEN_OVERRIDE=__SET_ME__setup_token

# ---- Admin UI (container Next.js separado) ----
# Porta do container Next.js do Admin UI.
# (default: 4000)
ADMIN_UI_PORT=4000

# URL pública do Admin UI. Precisa ser https fora de development.
# (default: http://localhost:4000)
NEXTAUTH_URL=http://localhost:4000

# Segredo de assinatura do NextAuth (gere com `openssl rand -base64 48`).
# Placeholders são recusados fora de development.
# (obrigatória em: staging, production · SEGREDO)
NEXTAUTH_SECRET=__SET_ME__rotate_with_openssl_rand_base64_48_before_first_boot

# Confia no Host vindo do proxy reverso (Coolify, nginx, ALB). Sem isso o
# NextAuth v5 recusa hosts que não batem com NEXTAUTH_URL.
# (default: false)
AUTH_TRUST_HOST=true

# URL do runtime Fastify consumida pelo Admin UI. Precisa ser https fora de
# development.
# (default: http://localhost:3000)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Gate mestre do Admin UI v1.
# (default: false)
# FEATURE_ADMIN_UI_V1=false

# Snapshots de debug no Admin UI.
# (default: false)
# FEATURE_ADMIN_UI_DEBUG_SNAPSHOTS=false

# Rejeição em lote no inbox do Admin UI.
# (default: true)
# FEATURE_ADMIN_UI_BULK_REJECT=true

# Re-decisão manual a partir do Admin UI.
# (default: false)
# FEATURE_ADMIN_UI_REDECIDE=false

# Habilita o provider de login de desenvolvimento. PROIBIDO fora de
# development — o boot recusa.
# (default: false · ativa apenas em: development)
# ALLOW_DEV_AUTH=false

# Token compartilhado do login de desenvolvimento (mínimo 16 caracteres).
# (obrigatória quando ALLOW_DEV_AUTH=true · SEGREDO · ativa apenas em:
# development)
# ADMIN_UI_DEV_LOGIN_TOKEN=__SET_ME__at_least_16_random_chars

# Issuer do IdP. Precisa ser https em staging/production.
# (obrigatória em: staging, production)
# OIDC_ISSUER=https://login.example.com/realms/maia

# Client id registrado no IdP.
# (obrigatória em: staging, production)
# OIDC_CLIENT_ID=maia-admin

# Client secret do IdP.
# (obrigatória em: staging, production · SEGREDO)
# OIDC_CLIENT_SECRET=__SET_ME__copy_from_IdP

# Lista (vírgula) não vazia de app_users.tenant_id que o IdP pode
# autenticar. Nunca cai para o literal `default`.
# (obrigatória em: staging, production)
# OIDC_TENANT_SLUGS=primary

# ---- Variáveis REMOVIDAS (tombstones) ----
# As variáveis abaixo não existem mais. Mantê-las no ambiente é recusado
# pela validação (erro em staging/produção, aviso em development) para que
# nenhum operador acredite estar controlando um caminho que já foi deletado.
#   FEATURE_MULTI_CHANNEL — removida em PR #411
#   FEATURE_COGNITIVE_GRAPH — removida em PR #412
#   FEATURE_CONTEXT_PACKET_V1 — removida em PR #406
#   FEATURE_CONTEXT_PACKET_V1_KILL_SWITCH — removida em PR #406
#   APROVAR_MENSAGENS_PROATIVAS — removida em issue #515 (use FEATURE_PROACTIVE_MESSAGES)
