# Enforce the pinned toolchain (see CONTRIBUTING.md → Toolchain and package.json
# `engines`). With engine-strict, npm REFUSES to install when the active Node/npm
# falls outside `engines` (node >=22.0.0, npm >=11.5.2 <12) instead of merely
# warning. This stops a contributor on the wrong npm (e.g. Node's bundled npm 10)
# from regenerating an incompatible-format package-lock.json and re-breaking CI
# (the exact failure from #312/#314). CI installs npm 11.5.2 before `npm ci`, so
# it satisfies the gate.
engine-strict=true
