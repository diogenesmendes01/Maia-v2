# Template for the dedicated TEST environment, not runtime .env.
# Copy to an operator-approved private file; chmod 600. Do not commit filled values.
# Empty endpoints deliberately fail until the new environment is provisioned.
HARNESS_REPO=/srv/agents/repos/Maia-v2
HARNESS_PG_HOST=127.0.0.1
HARNESS_PG_PORT=5435
HARNESS_PG_USER=hermes_sandbox
HARNESS_PG_DATABASE=maia_maintenance
HARNESS_PG_TEMPLATE=maia_template
PGPASSFILE=/home/hermes-sandbox/.config/hermes-test-postgres/pgpass
# Colon-separated existing mount paths: repo, dependencies/cache, DB storage.
HARNESS_DISK_PATHS=
HARNESS_CARD_DATABASE=
HARNESS_REDIS_PORT=
HARNESS_REDIS_DB=
# Same URL in both, password URL-encoded, dedicated localhost instance only.
DATABASE_URL=
TEST_DB_URL=
# Dedicated localhost Redis and exclusively assigned nonzero logical DB.
REDIS_URL=
# Source operator-provisioned /srv/agents/runtime/test-services.env for these.
# Expected upstream SHA: 5d59366010640c1d6b8f170d8a4ee109db2bbdef
MAIA_HERMES_UPSTREAM=
MAIA_HERMES_WORKER_PYTHON=
