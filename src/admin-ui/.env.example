# P8.5 Admin UI environment variables.
# Copy to .env.local for development; .env.local is gitignored.

# NEXTAUTH_SECRET: required for any session. In production this MUST be set to a
# >=32-char value; auth.ts refuses to boot otherwise (Codex review #101).
NEXTAUTH_SECRET=dev-secret-change-in-prod-please-make-this-at-least-32-chars
NEXTAUTH_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:3000
DATABASE_URL=postgresql://maia:maia@localhost:5432/maia_dev

# Feature flags (Task 16)
FEATURE_ADMIN_UI_V1=true
FEATURE_ADMIN_UI_DEBUG_SNAPSHOTS=false
FEATURE_ADMIN_UI_BULK_REJECT=true
FEATURE_ADMIN_UI_REDECIDE=false

# Dev-only auth (Codex review #101: closes the email-only auth bypass).
# The magic-link CredentialsProvider is registered ONLY if ALL of:
#   NODE_ENV !== 'production'
#   FEATURE_ADMIN_UI_V1 === 'true'
#   ALLOW_DEV_AUTH === 'true'
#   ADMIN_UI_DEV_LOGIN_TOKEN is set and >= 16 chars
# Set ALLOW_DEV_AUTH=false in any deployment that should ONLY accept OIDC/SAML.
ALLOW_DEV_AUTH=true
ADMIN_UI_DEV_LOGIN_TOKEN=replace-me-with-a-shared-dev-token-min-16-chars

# Pareamento de linhas WhatsApp pelo console (issue #518).
# O QR e o código só atravessam o Postgres CIFRADOS (AES-256-GCM). Estes DOIS
# valores precisam ser IDÊNTICOS aos do container `app` — o runtime cifra, o
# console decifra. Sem eles a tela de linhas mostra os estados mas não pareia.
#   MAIA_STAGING_KEYRING='{"k1":"<base64 de 32 bytes>"}'
#   MAIA_STAGING_ACTIVE_KEY_ID=k1
# Gere uma chave com: openssl rand -base64 32
MAIA_STAGING_KEYRING=
MAIA_STAGING_ACTIVE_KEY_ID=
