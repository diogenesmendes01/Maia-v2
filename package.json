{
  "name": "maia-v2",
  "version": "0.1.0",
  "description": "Maia — Assistente financeira inteligente via WhatsApp - PF + 8 PJs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "setup": "tsx scripts/setup.ts",
    "pessoa:add": "tsx scripts/pessoa-add.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "import:ofx": "tsx scripts/import-ofx.ts",
    "import:list": "tsx scripts/import-review.ts list",
    "import:show": "tsx scripts/import-review.ts show",
    "import:apply": "tsx scripts/import-review.ts apply",
    "dlq": "tsx scripts/dlq.ts",
    "backup": "tsx scripts/backup.ts",
    "restore:test": "tsx scripts/restore-test.ts",
    "embeddings:rebuild": "tsx scripts/embeddings-rebuild.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:leak": "vitest run tests/integration/leak.spec.ts tests/integration/repos-leak.spec.ts tests/unit/cross-entity.spec.ts tests/unit/constitutional.spec.ts",
    "test:integration:setup": "docker compose up -d redis postgres",
    "test:integration:teardown": "docker compose down -v",
    "test:integration": "vitest run tests/integration --no-coverage",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "admin:install": "cd src/admin-ui && npm install",
    "admin:dev": "bash scripts/admin-ui-dev.sh",
    "admin:build": "cd src/admin-ui && next build",
    "admin:start": "cd src/admin-ui && next start --port 4000",
    "admin:typecheck": "cd src/admin-ui && tsc --noEmit",
    "test:admin-ui:unit": "vitest run tests/admin-ui/unit/",
    "test:admin-ui:e2e": "playwright test tests/admin-ui/e2e/",
    "admin:acceptance": "bash scripts/admin-ui-acceptance-gates.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.21",
    "bullmq": "^5.20.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "openai": "^6.37.0",
    "pdfmake": "^0.3.8",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "protobufjs": "^7.5.5"
  },
  "devDependencies": {
    "@trpc/client": "11.0.0-rc.682",
    "@trpc/react-query": "11.0.0-rc.682",
    "@trpc/server": "11.0.0-rc.682",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.13.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^10.4.0",
    "fast-check": "^4.8.0",
    "prettier": "^3.3.3",
    "safe-regex2": "^5.1.1",
    "tinybench": "^6.0.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
