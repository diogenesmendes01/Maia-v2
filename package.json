{
  "name": "maia-v2",
  "version": "3.1.0",
  "description": "Maia — Plataforma multi-agente governada via WhatsApp",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.5.2 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs && node -e \"var ua=process.env.npm_config_user_agent||'';var m=ua.match(/npm\\/(\\d+)\\.(\\d+)\\.(\\d+)/);if(!m){process.exit(0)}var M=+m[1],n=+m[2],p=+m[3];if(!(M===11&&(n>5||(n===5&&p>=2)))){console.error('\\n\\u2716 npm '+m[1]+'.'+m[2]+'.'+m[3]+' is not in the pinned range (>=11.5.2 <12).\\n  This repo pins npm@11.5.2 so the package-lock.json format stays stable (see CONTRIBUTING.md).\\n  Installing with the wrong npm regenerates an incompatible lockfile and breaks CI.\\n  Fix: nvm install && nvm use   (Node 22 from .nvmrc)\\n       npm install -g npm@11.5.2\\n  Then re-run your install.\\n');process.exit(1)}\"",
    "check:node": "node scripts/check-node.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "setup": "tsx scripts/setup.ts",
    "probe:activate": "tsx scripts/activate-synthetic-probe.ts",
    "pessoa:add": "tsx scripts/pessoa-add.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "migrate:reserve": "tsx scripts/migrate-reserve.ts",
    "migrate:reservations:check": "tsx scripts/check-migration-reservations.ts",
    "smoke:migrate:image": "bash scripts/smoke-migrate-image.sh",
    "probe:drizzle-kit": "tsx scripts/probe-drizzle-kit.ts",
    "backfill:turns": "tsx scripts/backfill-agent-turns.ts",
    "import:ofx": "tsx scripts/import-ofx.ts",
    "import:list": "tsx scripts/import-review.ts list",
    "import:show": "tsx scripts/import-review.ts show",
    "import:apply": "tsx scripts/import-review.ts apply",
    "dlq": "tsx scripts/dlq.ts",
    "backup": "tsx scripts/backup.ts",
    "restore:test": "tsx scripts/restore-test.ts",
    "embeddings:rebuild": "tsx scripts/embeddings-rebuild.ts",
    "gen:tool-catalog": "tsx scripts/gen-tool-catalog.ts",
    "llm:bench": "tsx scripts/llm-benchmark.ts",
    "turn:bench": "tsx scripts/turn-context-benchmark.ts",
    "config:generate": "tsx scripts/config.ts generate",
    "config:check": "tsx scripts/config.ts check",
    "config:check:drift": "tsx scripts/config.ts generate --check",
    "config:init": "tsx scripts/config.ts init",
    "config:preflight": "tsx scripts/config.ts preflight",
    "doctor": "tsx scripts/doctor.ts",
    "docs:ai:check": "tsx scripts/check-ai-docs.ts",
    "pr:body:check": "tsx scripts/check-pr-body.ts",
    "audit:exceptions:check": "tsx scripts/check-audit-exceptions.ts",
    "sharp:smoke": "node scripts/sharp-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:leak": "vitest run tests/integration/leak.spec.ts tests/integration/repos-leak.spec.ts tests/integration/agent-tool-grants-leak.spec.ts tests/integration/playground-objectives-mcp-leak.spec.ts tests/unit/cross-entity.spec.ts tests/unit/constitutional.spec.ts tests/unit/agent-tool-grants-repo-scope.spec.ts tests/integration/synthetic-probe.spec.ts tests/unit/turn-context-cache.spec.ts tests/unit/turn-context-warm-cache.spec.ts tests/integration/turn-context-batch-repos.spec.ts tests/integration/agent-turns-leak.spec.ts tests/integration/onboarding-leak.spec.ts tests/unit/onboarding/readiness-facts-scope.spec.ts",
    "test:integration:setup": "tsx scripts/test-infra.ts up",
    "test:integration:teardown": "tsx scripts/test-infra.ts down",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:integration:real-db": "vitest run tests/integration/**/*real-db*.spec.ts --no-coverage",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "admin:install": "cd src/admin-ui && npm install",
    "admin:dev": "bash scripts/admin-ui-dev.sh",
    "admin:build": "cd src/admin-ui && next build",
    "admin:start": "cd src/admin-ui && next start --port 4000",
    "admin:typecheck": "cd src/admin-ui && tsc --noEmit",
    "test:admin-ui:unit": "vitest run tests/admin-ui/unit/",
    "test:admin-ui:e2e": "playwright test tests/admin-ui/e2e/",
    "admin:acceptance": "bash scripts/admin-ui-acceptance-gates.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@hapi/boom": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@whiskeysockets/baileys": "^6.7.23",
    "bullmq": "^5.78.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "ioredis": "^5.11.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "openai": "^6.37.0",
    "pdfmake": "^0.3.8",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "ioredis": "$ioredis",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.0.1",
    "@trpc/server": "11.17.0",
    "@types/node": "^25.9.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.13.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "fast-check": "^4.8.0",
    "prettier": "^3.3.3",
    "safe-regex2": "^5.1.1",
    "testcontainers": "^12.0.1",
    "tinybench": "^6.0.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
